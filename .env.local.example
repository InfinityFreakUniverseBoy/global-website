# Public website URL shown as a link on the homepage and used as the
# metadata base URL. Must be a valid http/https URL.
NEXT_PUBLIC_SITE_URL=https://webcamrandome.com

# Private admin phone number used for the homepage "Send SMS to admin" link.
# Server-only (no NEXT_PUBLIC_ prefix), so it is never bundled into the
# JavaScript sent to the browser. Copy this file to .env.local (gitignored)
# and set the real number there.
ADMIN_PHONE_NUMBER=
